# Copy to .env and fill in. Never commit .env.

# --- Supabase (required) -------------------------------------------------
# Project Settings > API in your Supabase dashboard.
SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-publishable-(anon)-key"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-(anon)-key"

# --- Server-side only (optional features; NEVER prefix with VITE_) --------
# SUPABASE_SERVICE_ROLE_KEY=""        # admin actions on the server
# RAZORPAY_KEY_ID=""                  # online payments
# RAZORPAY_KEY_SECRET=""
# GOOGLE_MAPS_API_KEY=""              # server-side maps lookups
# SUPER_ADMIN_EMAIL=""                # one-time Super Admin bootstrap
# SUPER_ADMIN_PASSWORD=""

# --- Browser keys for optional features ----------------------------------
# VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY=""
# VITE_LOVABLE_CONNECTOR_FIREBASE_MESSAGING_WEB_API_KEY=""
# VITE_LOVABLE_CONNECTOR_FIREBASE_MESSAGING_PROJECT_ID=""
# VITE_LOVABLE_CONNECTOR_FIREBASE_MESSAGING_APP_ID=""
# VITE_LOVABLE_CONNECTOR_FIREBASE_MESSAGING_VAPID_KEY=""
