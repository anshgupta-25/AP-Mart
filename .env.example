# Copy to .env and fill in. Never commit .env.

# --- Supabase (required) -------------------------------------------------
# Project Settings > API in your Supabase dashboard.
SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-publishable-(anon)-key"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-(anon)-key"

# --- Server-side only (NEVER prefix with VITE_) ---------------------------
SUPABASE_SERVICE_ROLE_KEY=""           # server functions (payments, admin actions)
# GOOGLE_MAPS_API_KEY=""               # Geocoding API + Routes API
# RAZORPAY_KEY_ID=""                   # online payments
# RAZORPAY_KEY_SECRET=""
# RAZORPAY_WEBHOOK_SECRET=""
# FIREBASE_SERVICE_ACCOUNT_JSON='{...}' # push sending; whole JSON on one line, single quotes
# SUPER_ADMIN_EMAIL=""                 # one-time Super Admin bootstrap
# SUPER_ADMIN_PASSWORD=""
# DATABASE_URL=""                      # Postgres URL, only for drizzle-kit

# --- Browser keys for optional features ----------------------------------
# VITE_GOOGLE_MAPS_BROWSER_KEY=""      # Maps JavaScript API + Places API
# VITE_FIREBASE_WEB_API_KEY=""
# VITE_FIREBASE_PROJECT_ID=""
# VITE_FIREBASE_APP_ID=""
# VITE_FIREBASE_VAPID_KEY=""
