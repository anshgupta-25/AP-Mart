# Copy to .env and fill in. Never commit .env.

# --- Supabase (required) -------------------------------------------------
# Project Settings > API in your Supabase dashboard.
SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-publishable-(anon)-key"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-(anon)-key"

# --- Server-side only (NEVER prefix with VITE_) ---------------------------
# Google Sign-In (Google Identity Services). Client ID is public; no client secret is used.
# Authorized JavaScript origins must include your site origin in Google Cloud Console.
VITE_GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_ID=   # optional server override of the audience checked on ID tokens
SUPABASE_SERVICE_ROLE_KEY=""           # server functions (payments, admin actions)
# GOOGLE_MAPS_API_KEY=""               # Geocoding API + Routes API
# Phone OTP via APITXT (server-side only; Supabase phone auth is NOT used)
# OTP_PROVIDER=apitxt
# APITXT_AUTH_KEY=""
# APITXT_BASE_URL="https://apitxt.com/api"
# APITXT_TEMPLATE_ID=""                # optional; approved DLT template id (SMS only)
# APITXT_CHANNEL=""                    # optional: sms | whatsapp | voice (default: SMS, falling back to WhatsApp)
# OTP_LENGTH=6                          # 4-8 digits
# OTP_EXPIRY_SECONDS=300
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_COOLDOWN=30               # seconds
# OTP_MAX_SENDS_PER_HOUR=5             # optional, per phone number
# PHONE_AUTH_EMAIL_DOMAIN=""           # optional; internal login email domain (default phone.apmart.invalid)
# RAZORPAY_KEY_ID=""                   # online payments
# RAZORPAY_KEY_SECRET=""
# RAZORPAY_WEBHOOK_SECRET=""
# FIREBASE_SERVICE_ACCOUNT_JSON='{...}' # push sending; whole JSON on one line, single quotes
# SUPER_ADMIN_EMAIL=""                 # one-time Super Admin bootstrap
# SUPER_ADMIN_PASSWORD=""
# DATABASE_URL=""                      # Postgres URL, only for drizzle-kit

# --- Browser keys for optional features ----------------------------------
# VITE_GOOGLE_MAPS_BROWSER_KEY=""      # Maps JavaScript API + Places API
# VITE_FIREBASE_WEB_API_KEY=""
# VITE_FIREBASE_PROJECT_ID=""
# VITE_FIREBASE_APP_ID=""
# VITE_FIREBASE_VAPID_KEY=""

# --- Auth emails (sign-up code, password reset, welcome) via Resend ------
# Server-only. EMAIL_FROM must use a domain verified in Resend (e.g. no-reply@apmart.in).
# RESEND_API_KEY=""
# EMAIL_FROM="AP Mart <no-reply@yourdomain.com>"
# Public site used in email links (no trailing slash), e.g. https://apmart.in
# PUBLIC_SITE_URL=""
