# Copy to .env.mobile for the Android build (`npm run build:mobile`).
# Values here are added on top of .env. These are PUBLIC (shipped in the app).

# Public HTTPS address of the deployed server (npm start), no trailing slash.
# The app sends payments, maps lookups and account actions here.
VITE_API_BASE_URL="https://your-app.onrender.com"

# Optional: website used in email links (confirm email, reset password).
# Defaults to VITE_API_BASE_URL.
# VITE_PUBLIC_SITE_URL="https://apmart.in"
